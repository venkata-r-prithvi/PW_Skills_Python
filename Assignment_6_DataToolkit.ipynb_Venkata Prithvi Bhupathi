    "#11.Perform matrix multiplication using NumPy\n",
    "import numpy as np\n",
    "arr1 = np.array([[1,2],\n",
    "                [3,4]]\n",
    "               )\n",
    "arr2 = np.array([[2,1],\n",
    "                [4,3]])\n",
    "\n",
    "\n",
    "if arr1.shape[1] == arr2.shape[0]: # Check if multiplication is possible\n",
    "    result = arr1 @ arr2\n",
    "    print(\"Matrix multiplication possible!\")\n",
    "    print(result)\n",
    "else:\n",
    "    print(\"Matrix multiplication NOT possible due to incompatible dimensions.\")\n",
    "# Matrix multiplication\n",
    "          \n",
    "result = np.dot(arr1, arr2)   # or arr1 @ arr2\n",
    "\n",
    "print(\"Matrix 1:\\n\", arr1)\n",
    "print(\"Matrix 2:\\n\", arr2)\n",
    "print(\"Result of Multiplication:\\n\", result)\n"
   ]
