    "#13.A Create a 3D scatter plot  using Plotly\n",
    "import plotly.express as px\n",
    "import pandas as pd\n",
    "\n",
    "# Data\n",
    "data = {\n",
    "    'A': [1, 2, 3, 4, 5],\n",
    "    'B': [10, 11, 12, 13, 14],\n",
    "    'C': [5, 4, 3, 2, 1],\n",
    "    'Category': ['R', 'B', 'G', 'Y', 'O']\n",
    "}\n",
    "\n",
    "\n",
    "df = pd.DataFrame(data) # Create DataFrame\n",
    "\n",
    "# Create 3D scatter plot\n",
    "fig = px.scatter_3d(\n",
    "    df,\n",
    "    x='A',\n",
    "    y='B',\n",
    "    z='C',\n",
    "    color='Category',   # categorical color\n",
    "    size='C',           # numeric size (use an existing column)\n",
    "    title='3D Scatter Plot Example'\n",
    ")\n",
    "\n",
    "# Show plot\n",
    "fig.show()\n"
   ]
